#Supabase key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

#Cloudinary key
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#Midtrans key
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=

# Checkout Method Configuration
# Controls which checkout methods are available to customers
# Valid values: 'marketplace', 'direct', 'both' (case-insensitive)
# 
# - 'marketplace': Only marketplace checkout (Shopee/Tokopedia) is available
#                  Midtrans direct checkout UI is hidden and payment processing is disabled
#                  This is the default mode during PSE registration period
# 
# - 'direct':      Only direct checkout via Midtrans is available
#                  Marketplace checkout UI is hidden
#                  Requires MIDTRANS_SERVER_KEY and MIDTRANS_CLIENT_KEY to be configured
# 
# - 'both':        Both marketplace and direct checkout options are available
#                  Customers can choose their preferred checkout method
#                  Requires MIDTRANS_SERVER_KEY and MIDTRANS_CLIENT_KEY for direct checkout
# 
# Default: 'marketplace' (if not set or invalid value provided)
# 
# Note: This is a feature toggle to temporarily disable direct checkout during PSE registration
#       without deleting the Midtrans integration code. Once PSE registration is complete,
#       change this to 'direct' or 'both' to re-enable direct checkout functionality.
CHECKOUT_METHOD=marketplace